<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Diagonal gradient: green → yellow → blue → red -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0"    android:color="#FF68C040"/>
                <item android:offset="0.33" android:color="#FFDDAC20"/>
                <item android:offset="0.67" android:color="#FF3A58C8"/>
                <item android:offset="1"    android:color="#FFD04444"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle top-left highlight -->
    <path
        android:pathData="M0,0 L72,0 Q0,0 0,72 Z"
        android:fillColor="#18FFFFFF"/>
</vector>
